 "cues": [
  {
   "start": 1.6,
   "slot": 4.6,
   "voice": "narrator",
   "text": "Meet Tony. Electrician. Dad. Currently pinned under a sleeping six-year-old."
  },
  {
   "start": 6.5,
   "slot": 6.4,
   "voice": "narrator",
   "text": "Whoever answers first usually wins. But his plans are at the office, and his prices are buried in email."
  },
  {
   "start": 13.0,
   "slot": 3.0,
   "voice": "aiva",
   "text": "I've got her plans from Tuesday. Want a price?"
  },
  {
   "start": 16.2,
   "slot": 6.6,
   "voice": "narrator",
   "text": "AIVA pulls the counts from Tuesday's takeoff, prices every line from Tony's price book, and builds the estimate."
  },
  {
   "start": 23.0,
   "slot": 4.3,
   "voice": "narrator",
   "text": "Eight thousand, nine hundred forty dollars, with a thirty percent deposit."
  },
  {
   "start": 27.6,
   "slot": 6.8,
   "voice": "narrator",
   "text": "She drafts the reply. Tony reads it, and Tony decides. Nothing goes out until he taps Queue for delivery."
  },
  {
   "start": 35.0,
   "slot": 8.1,
   "voice": "narrator",
   "text": "That's OfficeAdmin. One app that runs a contracting business, from the first text to the final payment. AIVA is the assistant inside it."
  },
  {
   "start": 43.2,
   "slot": 5.75,
   "voice": "narrator",
   "text": "Seven forty-two AM. Jen signs from her phone, and her deposit invoice is ready to pay."
  },
  {
   "start": 49.0,
   "slot": 5.6,
   "voice": "narrator",
   "text": "Friday, Tony books the crew. Ray and Sam see Monday's job right in the app."
  },
  {
   "start": 54.9,
   "slot": 7.9,
   "voice": "narrator",
   "text": "Sunday, eleven forty-eight PM. AIVA reads every job, every night. The crew starts at seven, and the deposit never came in."
  },
  {
   "start": 62.9,
   "slot": 2.6,
   "voice": "aiva",
   "text": "Want me to send Jen a friendly reminder?"
  },
  {
   "start": 65.6,
   "slot": 2.4,
   "voice": "narrator",
   "text": "Tony approves it, half asleep."
  },
  {
   "start": 68.2,
   "slot": 4.6,
   "voice": "narrator",
   "text": "Six fifty-one AM. Paid. At seven, Ray clocks in."
  },
  {
   "start": 73.2,
   "slot": 6.4,
   "voice": "narrator",
   "text": "Every day, the crew logs a daily report with photos. Tony knows where the job stands without driving over."
  },
  {
   "start": 80.0,
   "slot": 2.6,
   "voice": "narrator",
   "text": "Day three. Sam opens the wall."
  },
  {
   "start": 83.2,
   "slot": 2.6,
   "voice": "narrator",
   "text": "Old cloth wiring. Not in the estimate."
  },
  {
   "start": 86.2,
   "slot": 8.4,
   "voice": "narrator",
   "text": "Tony writes a change order from the photos, and Jen signs it from her desk. Twelve hundred forty dollars, in writing, before anyone pulls a wire."
  },
  {
   "start": 95.0,
   "slot": 3.9,
   "voice": "narrator",
   "text": "The punch list closes out. The inspection passes."
  },
  {
   "start": 99.4,
   "slot": 6.6,
   "voice": "narrator",
   "text": "One tap turns the estimate into the final invoice. One more bills the change order. Both get paid."
  },
  {
   "start": 106.4,
   "slot": 6.4,
   "voice": "narrator",
   "text": "Payments land in the bank feed and match themselves. Job costing shows what the job actually made."
  },
  {
   "start": 113.3,
   "slot": 2.8,
   "voice": "narrator",
   "text": "And Tony? He's at Mia's game."
  },
  {
   "start": 128.4,
   "slot": 4.2,
   "voice": "narrator",
   "text": "OfficeAdmin, with AIVA. Your office never clocks out."
  }
 ],
